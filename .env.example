# Paste your MongoDB Atlas connection string here. Replace the placeholders.
DATABASE_URL=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/svyasa_erp?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Optional in development. Private LAN origins are accepted automatically outside production.
# In production, set this to the exact HTTPS origins for all three portals.
# FRONTEND_ORIGINS=https://admin.example.edu,https://faculty.example.edu,https://students.example.edu
